{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "avalix-landing.vercel.app" }],
      "destination": "https://nexusinova.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "avalix-landing.vercel.app" }],
      "destination": "https://nexusinova.vercel.app/:path+",
      "permanent": true
    }
  ]
}
